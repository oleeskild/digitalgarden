{#- Rendered in both the header and afterContent slots; slotName (shared
    include scope, see components/pluginSlot.njk) says which one this is. -#}
{%- if page.url != "/" or pluginSettings.showOnHome -%}
{%- if pluginSettings.showCreated or pluginSettings.showUpdated -%}
{%- if pluginSettings.position == "both"
    or (pluginSettings.position == "bottom" and "afterContent" in slotName)
    or (pluginSettings.position != "bottom" and not ("afterContent" in slotName)) -%}
<div class="timestamps{% if "afterContent" in slotName %} timestamps-bottom{% endif %}">
  {%- if pluginSettings.showCreated and created -%}
  <div><i data-lucide="calendar-plus"></i> <span class="human-date" data-date="{{created}}"></span></div>
  {%- endif -%}
  {%- if pluginSettings.showUpdated and updated -%}
  <div><i data-lucide="calendar-clock"></i> <span class="human-date" data-date="{{updated}}"></span></div>
  {%- endif -%}
</div>
{%- endif -%}
{%- endif -%}
{%- endif -%}
