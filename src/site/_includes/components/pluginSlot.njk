{#
  Renders every enabled plugin's templates for one slot. Usage from a layout
  or component (Nunjucks includes share scope, so slotName is visible here):

    {% set slotName = "notes.footer" %}{% include "components/pluginSlot.njk" %}

  Slot templates are copies synced into _includes/plugins/ by the plugin
  loader, so they receive the full data cascade like any other include,
  plus pluginSettings — the rendering plugin's own resolved settings.
  See docs/PLUGINS.md for the contract.
#}
{%- if plugins and plugins.slots[slotName] -%}
  {%- for pluginSlotEntry in plugins.slots[slotName] -%}
    {%- set pluginSettings = plugins.settings[pluginSlotEntry.pluginId] -%}
    {% include pluginSlotEntry.file %}
  {%- endfor -%}
{%- endif -%}
